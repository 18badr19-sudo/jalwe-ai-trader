# ============================================================
# RESULT MODEL
# ============================================================

@dataclass
class RadarResult:

    symbols: list[str] = field(
        default_factory=list
    )

    status: str = "UNKNOWN"

    source: str = "FINVIZ"

    scanned_count: int = 0

    tradable_count: int = 0

    filters: dict[str, str] = field(
        default_factory=dict
    )

    warnings: list[str] = field(
        default_factory=list
    )

    error: Optional[str] = None


# ============================================================
# JALWE / APEX RADAR
# ============================================================

class ScannerEngine:
    """
    APEX Scanner Engine V2

    ROLE:
        First-stage opportunity filter.

    Strategy profile:
        SMALL_CAP_PRE_BREAKOUT

    Current screen:
        Price < $15
        Float < 20M
        Relative Volume > 1.5
        Stocks only

    IMPORTANT:
        This engine is RESEARCH ONLY.

        It does NOT:
        - buy
        - sell
        - submit orders
        - manage positions

    Intended pipeline:

        Market / Finviz
              ↓
        ScannerEngine
              ↓
        candidate symbols
              ↓
        NewsEngine
              ↓
        Liquidity / PreBreakout / AI
              ↓
        Research Packet
              ↓
        JALWE V4
    """

    # ========================================================
    # DEFAULT FILTERS
    # ========================================================

    DEFAULT_FILTERS = {
        "Price": "Under $15",
        "Float": "Under 20M",
        "Relative Volume": "Over 1.5",
        "Industry": "Stocks only (ex-Funds)",
    }

    # ========================================================
    # INIT
    # ========================================================

    def __init__(
        self,
    ) -> None:

        # ----------------------------------------------------
        # Supports BOTH old Apex names and new JALWE names.
        # ----------------------------------------------------

        self.api_key = (
            os.getenv(
                "APCA_API_KEY_ID"
            )
            or
            os.getenv(
                "ALPACA_API_KEY"
            )
            or
            ""
        ).strip()

        self.api_secret = (
            os.getenv(
                "APCA_API_SECRET_KEY"
            )
            or
            os.getenv(
                "ALPACA_SECRET_KEY"
            )
            or
            ""
        ).strip()

        self.base_url = (
            os.getenv(
                "APCA_API_BASE_URL"
            )
            or
            os.getenv(
                "ALPACA_BASE_URL"
            )
            or
            "https://paper-api.alpaca.markets"
        ).strip()

        self.alpaca: Optional[
            REST
        ] = None

        self._initialize_alpaca()

    # ========================================================
    # CREDENTIAL STATUS
    # ========================================================

    def credentials_ready(
        self,
    ) -> bool:

        return bool(
            self.api_key
            and
            self.api_secret
        )

    # ========================================================
    # ALPACA
    # ========================================================

    def _initialize_alpaca(
        self,
    ) -> None:

        if not self.credentials_ready():

            logger.warning(
                "ScannerEngine Alpaca "
                "credentials are missing."
            )

            self.alpaca = None
            return

        # ----------------------------------------------------
        # Hard PAPER-only check
        # ----------------------------------------------------

        if (
            "paper-api.alpaca.markets"
            not in
            self.base_url.lower()
        ):

            logger.error(
                "ScannerEngine blocked because "
                "Alpaca URL is not PAPER."
            )

            self.alpaca = None
            return

        try:

            self.alpaca = REST(
                self.api_key,
                self.api_secret,
                self.base_url,
                api_version="v2",
            )

        except Exception as exc:

            logger.exception(
                "Could not initialize Alpaca "
                "inside ScannerEngine: %s",
                exc,
            )

            self.alpaca = None

    # ========================================================
    # SYMBOL NORMALIZATION
    # ========================================================

    @staticmethod
    def _normalize_symbol(
        symbol: Any,
    ) -> Optional[str]:

        symbol = str(
            symbol
            or ""
        ).strip().upper()

        if not symbol:
            return None

        if len(symbol) > 15:
            return None

        blocked = {
            "/",
            "^",
            " ",
        }

        if any(
            character in symbol
            for character in blocked
        ):

            return None

        return symbol

    # ========================================================
    # FINVIZ SCREEN
    # ========================================================

    def _run_finviz_screen(
        self,
        filters: dict[str, str],
    ) -> tuple[
        list[str],
        list[str],
    ]:

        warnings: list[str] = []

        try:

            overview = Overview()

            overview.set_filter(
                filters_dict=filters
            )

            dataframe = (
                overview.screener_view()
            )

        except Exception as exc:

            raise RuntimeError(
                "Finviz screening failed: "
                + str(exc)
            ) from exc

        if dataframe is None:
            return [], [
                "FINVIZ_RETURNED_NONE"
            ]

        if dataframe.empty:
            return [], []

        if (
            "Ticker"
            not in dataframe.columns
        ):

            raise RuntimeError(
                "Finviz response does not "
                "contain Ticker column."
            )

        symbols: list[str] = []

        seen: set[str] = set()

        for raw_symbol in (
            dataframe["Ticker"]
            .tolist()
        ):

            symbol = (
                self._normalize_symbol(
                    raw_symbol
                )
            )

            if symbol is None:
                continue

            if symbol in seen:
                continue

            seen.add(
                symbol
            )

            symbols.append(
                symbol
            )

        return (
            symbols,
            warnings,
        )

    # ========================================================
    # ALPACA TRADABILITY
    # ========================================================

    def _is_tradable(
        self,
        symbol: str,
    ) -> bool:

        if self.alpaca is None:
            return False

        try:

            asset = (
                self.alpaca
                .get_asset(
                    symbol
                )
            )

        except Exception:

            return False

        if not bool(
            getattr(
                asset,
                "tradable",
                False,
            )
        ):
            return False

        status = str(
            getattr(
                asset,
                "status",
                "",
            )
            or ""
        ).strip().lower()

        if (
            status
            and
            status != "active"
        ):
            return False

        return True

    # ========================================================
    # RUN RADAR
    # ========================================================

    def run_radar(
        self,
        *,
        filters: Optional[
            dict[str, str]
        ] = None,
        verify_with_alpaca: bool = True,
    ) -> RadarResult:

        active_filters = dict(
            filters
            or
            self.DEFAULT_FILTERS
        )

        # ----------------------------------------------------
        # Finviz first-stage scan
        # ----------------------------------------------------

        try:

            (
                tickers,
                warnings,
            ) = (
                self._run_finviz_screen(
                    active_filters
                )
            )

        except Exception as exc:

            logger.exception(
                "Radar Finviz stage failed."
            )

            return RadarResult(
                symbols=[],
                status="ERROR",
                source="FINVIZ",
                scanned_count=0,
                tradable_count=0,
                filters=active_filters,
                warnings=[
                    "FINVIZ_STAGE_FAILED"
                ],
                error=str(
                    exc
                ),
            )

        # ----------------------------------------------------
        # Nothing matched
        # ----------------------------------------------------

        if not tickers:

            return RadarResult(
                symbols=[],
                status="NO_MATCHES",
                source="FINVIZ",
                scanned_count=0,
                tradable_count=0,
                filters=active_filters,
                warnings=warnings,
                error=None,
            )

        scanned_count = len(
            tickers
        )

        # ----------------------------------------------------
        # Optional Alpaca validation
        # ----------------------------------------------------

        if not verify_with_alpaca:

            return RadarResult(
                symbols=tickers,
                status="SUCCESS_UNVERIFIED",
                source="FINVIZ",
                scanned_count=scanned_count,
                tradable_count=len(
                    tickers
                ),
                filters=active_filters,
                warnings=warnings,
                error=None,
            )

        # ----------------------------------------------------
        # Cannot verify tradability
        # ----------------------------------------------------

        if self.alpaca is None:

            warnings.append(
                "ALPACA_VALIDATION_UNAVAILABLE"
            )

            return RadarResult(
                symbols=[],
                status="VALIDATION_UNAVAILABLE",
                source="FINVIZ",
                scanned_count=scanned_count,
                tradable_count=0,
                filters=active_filters,
                warnings=warnings,
                error=(
                    "Alpaca is unavailable, "
                    "so candidates were not "
                    "approved for JALWE research."
                ),
            )

        # ----------------------------------------------------
        # Validate symbols with Alpaca
        # ----------------------------------------------------

        valid_targets: list[str] = []

        for ticker in tickers:

            if self._is_tradable(
                ticker
            ):

                valid_targets.append(
                    ticker
                )

            else:

                logger.info(
                    "Radar excluded %s because "
                    "it is not active/tradable "
                    "on Alpaca.",
                    ticker,
                )

        # ----------------------------------------------------
        # No valid Alpaca targets
        # ----------------------------------------------------

        if not valid_targets:

            return RadarResult(
                symbols=[],
                status="NO_TRADABLE_TARGETS",
                source="FINVIZ+ALPACA",
                scanned_count=scanned_count,
                tradable_count=0,
                filters=active_filters,
                warnings=warnings,
                error=None,
            )

        # ----------------------------------------------------
        # Success
        # ----------------------------------------------------

        logger.info(
            "ScannerEngine radar: "
            "%s Finviz candidates -> "
            "%s Alpaca tradable candidates.",
            scanned_count,
            len(
                valid_targets
            ),
        )

        return RadarResult(
            symbols=valid_targets,
            status="SUCCESS",
            source="FINVIZ+ALPACA",
            scanned_count=scanned_count,
            tradable_count=len(
                valid_targets
            ),
            filters=active_filters,
            warnings=warnings,
            error=None,
        )

    # ========================================================
    # HEALTH
    # ========================================================

    def health_check(
        self,
    ) -> dict[str, Any]:

        return {
            "credentials_present": (
                self.credentials_ready()
            ),

            "alpaca_initialized": (
                self.alpaca
                is not None
            ),

            "paper_url": (
                "paper-api.alpaca.markets"
                in
                self.base_url.lower()
            ),

            "env_file": str(
                ENV_FILE
            ),

            "env_file_exists": (
                ENV_FILE.exists()
            ),

            "strategy_profile": (
                "SMALL_CAP_PRE_BREAKOUT"
            ),

            "order_execution_enabled": (
                False
            ),
        }


# ============================================================
# OLD COMPATIBILITY FUNCTION
# ============================================================

def run_jalwe_radar() -> list[str]:
    """
    Keeps old Apex code working.

    New code should prefer:

        ScannerEngine().run_radar()

    because the structured result also contains
    status, source and warnings.
    """

    try:

        engine = (
            ScannerEngine()
        )

        result = (
            engine.run_radar(
                verify_with_alpaca=True
            )
        )

        return list(
            result.symbols
        )

    except Exception as exc:

        logger.exception(
            "run_jalwe_radar failed: %s",
            exc,
        )

        return []


